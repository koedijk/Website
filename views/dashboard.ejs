<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Dashboard</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f4f4;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .dashboard {
            background: white;
            padding: 2rem;
            border-radius: 8px;
            max-width: 800px;
            width: 100%;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
        }
        h1, h2 {
            color: #333;
            text-align: center;
        }
        p {
            margin: 0.5rem 0;
        }
        .logout {
            margin-top: 2rem;
            text-align: center;
        }
        .logout a {
            color: white;
            background-color: #d9534f;
            padding: 0.5rem 1rem;
            text-decoration: none;
            border-radius: 4px;
            transition: background-color 0.3s ease;
        }
        .logout a:hover {
            background-color: #c9302c;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 1rem;
        }
        th, td {
            padding: 0.75rem;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }
        th {
            background-color: #f8f8f8;
        }
        tr:hover {
            background-color: #f1f1f1;
        }
        button {
            padding: 0.5rem;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            margin-left: 1rem;
            transition: background-color 0.3s ease;
        }
        button:hover {
            background-color: #0056b3;
        }
        .api-key-container {
            display: flex;
            align-items: center;
        }
    </style>
</head>
<body>
    <div class="dashboard">
        <h1>Welcome to Your Dashboard</h1>
        <p><strong>Name:</strong> <%= tornName %></p>
        <p><strong>Torn ID:</strong> <%= tornId %></p>
        <p><strong>Faction ID:</strong> <%= factionId %></p>
        <div class="api-key-container">
            <p><strong>API Key:</strong></p>
            <span id="apiKey" style="letter-spacing: 2px;">••••••••••••••••</span>
            <button onclick="toggleApiKey()">Show</button>
        </div>
       

        <h2>Faction Members</h2>
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Timer</th>
                </tr>
            </thead>
            <tbody>
                <% Object.values(members).forEach(member => { %>
                    <tr>
                        <td><%= member.name %></td>
                        <td><%= member.status.description %></td>
                        <td>
                            <% if (member.status.description === 'Hospital' || member.status.description === 'Jail') { %>
                                <%= member.status.until %> seconds
                            <% } else { %>
                                -
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>

        <div class="logout">
            <a href="/auth/logout">Logout</a>
        </div>
    </div>

    <script>
        const actualKey = "<%= apiKey %>";
        let isVisible = false;

        function toggleApiKey() {
            const keySpan = document.getElementById('apiKey');
            const button = event.target;

            if (isVisible) {
                keySpan.textContent = '••••••••••••••••';
                button.textContent = 'Show';
            } else {
                keySpan.textContent = actualKey;
                button.textContent = 'Hide';
            }

            isVisible = !isVisible;
        }
    </script>
</body>
</html>
