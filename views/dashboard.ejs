<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Dashboard</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f4f4;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .dashboard {
            background: white;
            padding: 2rem;
            border-radius: 8px;
            max-width: 800px;
            width: 100%;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
        }

        h1,
        h2 {
            color: #333;
            text-align: center;
        }

        p {
            margin: 0.5rem 0;
        }

        .logout {
            margin-top: 2rem;
            text-align: center;
        }

        .logout a {
            color: white;
            background-color: #d9534f;
            padding: 0.5rem 1rem;
            text-decoration: none;
            border-radius: 4px;
            transition: background-color 0.3s ease;
        }

        .logout a:hover {
            background-color: #c9302c;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 1rem;
        }

        th,
        td {
            padding: 0.75rem;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        th {
            background-color: #f8f8f8;
        }

        tr:hover {
            background-color: #f1f1f1;
        }

        button {
            padding: 0.5rem;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            margin-left: 1rem;
            transition: background-color 0.3s ease;
        }

        button:hover {
            background-color: #0056b3;
        }

        .api-key-container {
            display: flex;
            align-items: center;
        }
    </style>
</head>

<body>
    <div class="dashboard">
        <h1>Welcome to Your Dashboard</h1>
        <p><strong>Name:</strong>
            <%= tornName %>
        </p>
        <p><strong>Torn ID:</strong>
            <%= tornId %>
        </p>
        <p><strong>Faction ID:</strong>
            <%= factionId %>
        </p>

        <h2>Faction Members</h2>
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Timer</th>
                </tr>
            </thead>
            <tbody>
                <% Object.values(members).forEach(member=> { %>
                    <tr>
                        <td>
                            <%= member.name %>
                        </td>
                        <td>
                            <%= member.status.description %>
                        </td>
                        <td>
                            <% if (member.status.description==='Hospital' || member.status.description==='Jail' ) { %>
                                <%= member.status.until %> seconds
                                    <% } else { %>
                                        -
                                        <% } %>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>

        <h2>Enemy Faction</h2>
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Claim</th>
                </tr>
            </thead>
            <tbody>
                <% enemyMembers.forEach(member=> { %>
                    <tr>
                        <td>
                            <%= member.name %>
                        </td>
                        <td>
                            <%= member.status %>
                        </td>
                        <td>
                            <% if (member.claimedBy) { %>
                                <%= member.claimedBy %>
                                    <form method="POST" action="/auth/cancel-claim" style="display:inline;">
                                        <input type="hidden" name="name" value="<%= member.name %>">
                                        <button type="submit">Cancel</button>
                                    </form>
                                    <% } else { %>
                                        <form method="POST" action="/auth/claim">
                                            <input type="hidden" name="name" value="<%= member.name %>">
                                            <button type="submit">Claim</button>
                                        </form>
                                        <% } %>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>


        <div class="logout">
            <a href="/auth/logout">Logout</a>
        </div>
    </div>
</body>

</html>