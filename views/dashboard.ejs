<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Dashboard</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 2rem;
            background-color: #f4f4f4;
        }
        .dashboard {
            background: white;
            padding: 2rem;
            border-radius: 8px;
            max-width: 600px;
            margin: auto;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
        h1 {
            color: #333;
        }
        p {
            margin: 0.5rem 0;
        }
        .logout {
            margin-top: 2rem;
        }
        .logout a {
            color: white;
            background-color: #d9534f;
            padding: 0.5rem 1rem;
            text-decoration: none;
            border-radius: 4px;
        }
    </style>
</head>
<body>
    <div class="dashboard">
        <h1>Welcome to Your Dashboard</h1>
        <p><strong>User ID:</strong> <%= userId %></p>
        <p><strong>Torn ID:</strong> <%= tornId %></p>
        <p><strong>Faction ID:</strong> <%= factionId %></p>
        <p><strong>API Key:</strong> <%= apiKey %></p>
        <p><strong>Name:</strong> <%= tornName %></p>

        <div class="logout">
            <a href="/auth/logout">Logout</a>
        </div>
    </div>
</body>
</html>