<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/dashboard.js" defer></script>
  <script src="/socket.io/socket.io.js"></script>
</head>

<body>
  <div class="dashboard">
    <p id="lastUpdated">
      Last updated: <span id="updateTime">-</span>
    </p>

    <h1>Welcome to Your Dashboard</h1>
    <p><strong>Name:</strong>
      <%= tornName %>
    </p>
    <p><strong>Torn ID:</strong>
      <%= tornId %>
    </p>
    <p><strong>Faction ID:</strong>
      <%= factionId %>
    </p>
    <div class="logout">
      <a href="/auth/logout">Logout</a>
    </div>

<div class="layout-toggle">
  <button id="layout-toggle" type="button">Toggle Layout</button>
</div>


    <div id="factionContainer" class="horizontal-layout">
      <!-- Your Faction -->
      <div class="faction-block">
        <h2>Your Faction</h2>
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Status</th>
              <th>Timer</th>
            </tr>
          </thead>
          <tbody>
            <% Object.values(members).forEach(member=> { const safeId = member.name.replace(/[^a-zA-Z0-9]/g, ''); %>
              <tr data-name="<%= safeId %>">
                <td>
                  <%= member.name %>
                </td>
                <td class="status">
                  <%= member.status.description %>
                </td>
                <td class="timer">
                  <% if (['Hospital', 'Jail' ].includes(member.status.description) && member.statusUntil) { %>
                    <span class="countdown" data-until="<%= member.statusUntil %>"></span>
                    <% } else { %>-<% } %>
                </td>
              </tr>
              <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Enemy Faction -->
      <div class="faction-block">
        <h2>Enemy Faction: <%= enemyFactionName %>
        </h2>
        <table>
          <thead>

            <tr>
              <th>Name</th>
              <th>Status</th>
              <th>Timer</th>
              <th>Claimed By</th>
              <th>Action</th>
            </tr>


          </thead>
          <tbody>
            <% enemyMembers.forEach(member=> { const safeId = member.name.replace(/[^a-zA-Z0-9]/g, ''); %>
              <tr data-name="<%= safeId %>">
                <td>
                  <%= member.name %>
                </td>
                <td class="status">
                  <%= member.status || 'Unknown' %>
                </td>
                <td class="timer">
                  <% if (['Hospital', 'Jail' ].includes(member.status) && member.statusUntil) { %>
                    <span class="countdown" data-until="<%= member.statusUntil %>"></span>
                    <% } else { %>-<% } %>
                </td>
                <td class="claimed-by">
                  <%= member.claimedBy || '-' %>
                </td>
                <td class="claim-action">
                  <% if (!member.claimedBy && (member.status==='Okay' || (member.status==='Hospital' &&
                    member.statusUntil && (member.statusUntil * 1000 - Date.now()) < 300000))) { %>
                    <form method="POST" action="/auth/claim">
                      <input type="hidden" name="name" value="<%= member.name %>">
                      <button type="submit">Claim</button>
                    </form>
                    <% } else if (member.claimedBy) { %>
                      <form method="POST" action="/auth/cancel-claim">
                        <input type="hidden" name="name" value="<%= member.name %>">
                        <button type="submit">Cancel</button>
                      </form>
                      <% } %>
                </td>

              </tr>
              <% }) %>
          </tbody>
        </table>
      </div>
    </div>


  </div>

</body>

</html>