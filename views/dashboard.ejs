<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Dashboard</title>
    <link rel="stylesheet" href="/css/style.css"> <!-- Ensure this path is correct -->
</head>

<body>
    <div class="dashboard">
        <h1>Welcome to Your Dashboard</h1>
        <p><strong>Name:</strong>
            <%= tornName %>
        </p>
        <p><strong>Torn ID:</strong>
            <%= tornId %>
        </p>
        <p><strong>Faction ID:</strong>
            <%= factionId %>
        </p>

        <h2>Faction Members</h2>
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Timer</th>
                </tr>
            </thead>
            <tbody>
                <% Object.values(members).forEach(member=> { %>
                    <tr>
                        <td>
                            <%= member.name %>
                        </td>
                        <td>
                            <%= member.status.description %>
                        </td>
                        <td>
                            <% if (member.status.description==='Hospital' || member.status.description==='Jail' ) { %>
                                <%= member.status.until %> seconds
                                    <% } else { %>
                                        -
                                        <% } %>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>

        <p style="text-align: center; margin-top: 1rem; color: #666;">
            Showing: <strong>
                <%= warType==='last' ? 'Last War' : 'Current War' %>
            </strong>
        </p>

        <h2>Enemy Faction: <%= enemyFactionName %>
        </h2>
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Claim</th>
                </tr>
            </thead>
            <tbody>
                <% enemyMembers.forEach(member=> { %>
                    <tr>
                        <td>
                            <%= member.name %>
                        </td>

                        <td>
                            <%= member.status || 'Unknown' %>
                                <% if ((member.status==='Hospital' || member.status==='Jail' ) && member.statusUntil) {
                                    %>
                                    (<span class="countdown" data-until="<%= member.statusUntil %>"></span>)
                                    <% } %>
                        </td>

                        <td>
                            <% if (member.claimedBy) { %>
                                <%= member.claimedBy %>
                                    <form method="POST" action="/auth/cancel-claim" style="display:inline;">
                                        <input type="hidden" name="name" value="<%= member.name %>">
                                        <button type="submit">Cancel</button>
                                    </form>
                                    <% } else { %>
                                        <form method="POST" action="/auth/claim">
                                            <input type="hidden" name="name" value="<%= member.name %>">
                                            <button type="submit">Claim</button>
                                        </form>
                                        <% } %>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>

        <div style="text-align: center; margin-top: 2rem;">
            <button onclick="updateEnemyStatus()">Update Enemy Status</button>
            <p id="updateStatus" style="margin-top: 1rem; color: #555;"></p>
        </div>

        <div class="logout">
            <a href="/auth/logout">Logout</a>
        </div>
    </div>

    <script>
        function updateCountdowns() {
            const now = Math.floor(Date.now() / 1000);
            document.querySelectorAll('.countdown').forEach(el => {
                const until = parseInt(el.dataset.until, 10);
                const secondsLeft = Math.max(0, until - now);
                const minutes = Math.floor(secondsLeft / 60);
                const seconds = secondsLeft % 60;
                el.textContent = `${minutes}m ${seconds}s left`;
            });
        }

        function updateEnemyStatus() {
            const statusEl = document.getElementById('updateStatus');
            statusEl.textContent = 'Updating...';

            fetch('/auth/fetch-enemy-live', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({})
            }).then(res => {
                if (res.ok) {
                    statusEl.textContent = 'Enemy status updated.';
                    setTimeout(() => location.reload(), 1000);
                } else {
                    statusEl.textContent = 'Failed to update.';
                }
            }).catch(() => {
                statusEl.textContent = 'Error occurred.';
            });
        }

        updateCountdowns();
        setInterval(updateCountdowns, 100);
    </script>
</body>

</html>